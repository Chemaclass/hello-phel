(ns hello-phel.sqlite-example)

;; How to use SQLite3 in Phel
;; Idea from: http://zetcode.com/php/sqlite3/

(def db (SQLite3. "./data/test.db"))

(defstruct Car [id name price])

(.exec db "DROP TABLE IF EXISTS cars")
(.exec db "CREATE TABLE cars(id INTEGER PRIMARY KEY, name TEXT, price INT)")
(.exec db "INSERT INTO cars(name, price) VALUES('Audi', 52642)")
(.exec db "INSERT INTO cars(name, price) VALUES('Mercedes', 57127)")
(.exec db "INSERT INTO cars(name, price) VALUES('Skoda', 9000)")
(.exec db "INSERT INTO cars(name, price) VALUES('Volvo', 29000)")
(.exec db "INSERT INTO cars(name, price) VALUES('Bentley', 350000)")
(.exec db "INSERT INTO cars(name, price) VALUES('Citroen', 21000)")
(.exec db "INSERT INTO cars(name, price) VALUES('Hummer', 41400)")
(.exec db "INSERT INTO cars(name, price) VALUES('Volkswagen', 21600)")

(defn cast-array-to-struct-car [car]
  (Car (get car "id") (get car "name") (get car "price")))

(defn find-all-cars [db]
  (let [cars-query (.query db "SELECT * FROM cars")]
    (loop [cars []
           row  (.fetchArray cars-query)]
      (if row
        (recur
         (conj cars (cast-array-to-struct-car (php-array-to-map row)))
         (.fetchArray cars-query))
        cars))))

(def cars (find-all-cars db))

(println "Car names:" (str (map #(get % :name) cars))) ; ("Audi" "Mercedes" "Skoda" "Volvo" "Bentley" "Citroen" "Hummer" "Volkswagen")

(println "First two cars:" (str (map #(str %) (take 2 cars)))) ; ("(hello_phel.sqlite_example.Car 1 \"Audi\" 52642)" "(hello_phel.sqlite_example.Car 2 \"Mercedes\" 57127)")

(defn find-one-car-by-id [db id]
  (let [stmt (.prepare db "SELECT * FROM cars WHERE id = :id")]
    (.bindValue stmt ":id" id)
    (let [res (.execute stmt)]
      (cast-array-to-struct-car (.fetchArray res)))))

(println "One car by id:" (str (find-one-car-by-id db 3))) ; (hello_phel.sqlite_example.Car 3 "Skoda" 9000)

(defn print-nice-cars-table [cars]
  (printf " %-10s %s\n" "NAME" "PRICE")
  (doseq [car cars]
    (printf " %-10s %s\n" (get car :name) (get car :price))))

(when-not *build-mode*
  (println "List with all cars")
  (print-nice-cars-table cars))
